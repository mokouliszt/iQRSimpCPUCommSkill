# Byte-compiled / optimized / cache
__pycache__/
*.py[cod]
*$py.class

# Pytest / coverage / type-checker caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Local scratch
temp/
tmp/
*.log

# Distribution artifacts (this repo is distributed as a Skill, not a Python package,
# but ignore these in case anyone experiments locally)
build/
dist/
*.egg-info/
